{
    "name": "@citation-manager/citation-service",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx --watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate --schema=../../shared/prisma/schema.prisma",
        "prisma:push": "prisma db push --schema=../../shared/prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --schema=../../shared/prisma/schema.prisma",
        "prebuild": "pnpm clean && pnpm prisma:generate",
        "predev": "pnpm prisma:generate",
        "prepare": "pnpm prisma:generate",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@fastify/cors": "^8.5.0",
        "@prisma/client": "^6.4.1",
        "fastify": "^4.25.2",
        "pino": "^8.0.0",
        "pino-pretty": "^10.0.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.5",
        "@fastify/ajv-compiler": "^3.5.0",
        "@fastify/error": "^3.4.1",
        "@fastify/fast-json-stringify-compiler": "^4.3.0",
        "ajv": "^8.12.0",
        "fast-json-stringify": "^5.13.0",
        "find-my-way": "^8.1.0",
        "light-my-request": "^5.12.0",
        "pino-std-serializers": "^6.2.2",
        "sonic-boom": "^3.8.0",
        "prisma": "^6.4.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "undici-types": "^5.26.5"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js"
        }
    }
}
