{
  "name": "classifier-service",
  "version": "1.0.0",
  "description": "API service for managing classifiers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --skipLibCheck",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "prisma:generate": "prisma generate --schema=../../shared/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../../shared/prisma/schema.prisma",
    "prebuild": "pnpm prisma:generate",
    "predev": "pnpm prisma:generate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@prisma/client": "^6.4.1",
    "fastify": "^4.25.2",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@fastify/ajv-compiler": "^3.5.0",
    "@fastify/error": "^3.4.1",
    "@fastify/fast-json-stringify-compiler": "^4.3.0",
    "ajv": "^8.12.0",
    "fast-json-stringify": "^5.13.0",
    "find-my-way": "^8.1.0",
    "light-my-request": "^5.12.0",
    "pino-std-serializers": "^6.2.2",
    "sonic-boom": "^3.8.0",
    "prisma": "^6.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "undici-types": "^5.26.5"
  }
} 